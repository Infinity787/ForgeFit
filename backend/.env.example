# Copy to .env for local development. In production set these as environment
# variables on your host (Render → Environment). Never commit real values.

PORT=4000
# Set to "production" on your host: enables the startup secret checks and
# stops password-reset codes ever being returned by the API.
NODE_ENV=development

# PostgreSQL connection string.
#   Local:  postgresql:///forgefit_dev?host=/tmp
#   Render: use the database's "Internal Database URL"
DATABASE_URL=postgresql:///forgefit_dev?host=/tmp
# TLS is auto-enabled for non-local hosts; override with true/false if needed.
# DATABASE_SSL=
# AUTO_MIGRATE=true

# Comma-separated origins allowed to call the API. Include your web app's URL
# and the Android app's origin (https://localhost for Capacitor).
CORS_ORIGIN=http://localhost:5173,https://localhost

# Long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# ---- Email ----
# brevo   = Brevo's HTTP API (needs BREVO_API_KEY + EMAIL_FROM or BREVO_SENDER_EMAIL)
# smtp    = any SMTP server (SMTP_* below)
# console = development only: codes print to the server log and signup codes
#           are returned to the app. Never use in production.
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ForgeFit <no-reply@yourdomain.com>"
BREVO_API_KEY=
# Enables GET /api/auth/admin/users (header x-admin-secret). Leave empty to disable.
ADMIN_SECRET=

# ---- AI (Google Gemini) ----
# Powers Coach chat, online food search and food-photo macro estimates.
# Create a key at https://aistudio.google.com/apikey. Server-side only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI requests allowed per user per hour.
# AI_HOURLY_LIMIT=60
